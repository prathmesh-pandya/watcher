# ---------------------------------------------------------------------------
# Copy to .env at the repo root. Every app loads this same file.
# Nothing in here has a hardcoded fallback in the code -- required vars throw
# on boot if missing.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=debug

# --- Datastores ------------------------------------------------------------
MONGO_URI=mongodb://127.0.0.1:27017/repo-watcher
REDIS_URL=redis://127.0.0.1:6379

# --- API server ------------------------------------------------------------
PORT=4000
# Shared token guarding every /api route. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_TOKEN=replace-me-with-a-long-random-string
# Comma-separated origins allowed to call the API (the Vite dev server).
CORS_ORIGINS=http://localhost:5173

# --- GitHub ----------------------------------------------------------------
# Fallback webhook secret, used when a RepoConfig has no secret of its own.
GITHUB_WEBHOOK_SECRET=replace-me-with-the-secret-you-typed-into-github
# PAT with `repo` (private) or `public_repo` scope -- needed for the compare API.
GITHUB_TOKEN=ghp_replace_me
GITHUB_API_BASE=https://api.github.com

# --- Anthropic (worker only; the LLM calls are stubs in this pass) ---------
ANTHROPIC_API_KEY=sk-ant-replace-me
ANTHROPIC_MODEL=claude-opus-5
# Diffs larger than this are truncated before being sent to the model.
MAX_DIFF_CHARS=180000

# --- MiniMax (feature-doc generation) --------------------------------------
MINIMAX_API_KEY=replace-me-with-your-minimax-key
MINIMAX_MODEL=MiniMax-M3
# MUST match the platform your account belongs to. MiniMax runs separate
# international and domestic (api.minimaxi.com / api.minimax.chat) endpoints,
# and pointing at the wrong one fails auth even with a perfectly valid key.
MINIMAX_BASE_URL=https://api.minimax.io/v1

# --- Worker ----------------------------------------------------------------
WORKER_CONCURRENCY=2

# --- Web (Vite dev server) -------------------------------------------------
# Where `npm run dev:web` proxies /api and /health. Match PORT above.
VITE_API_PROXY_TARGET=http://localhost:4000
